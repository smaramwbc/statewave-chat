{
  "name": "statewave-chat",
  "private": true,
  "description": "Reusable Statewave chat packages",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@9.0.0",
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm build && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.1",
    "typescript": "^6.0.0"
  },
  "pnpm": {
    "overrides": {
      "read-yaml-file": "^2.1.0"
    }
  }
}
